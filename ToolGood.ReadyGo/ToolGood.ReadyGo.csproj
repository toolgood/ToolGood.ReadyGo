<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A high performance Micro-ORM supporting SQL Server, MySQL, Sqlite, PostgreSQL, Oracle, Firebird. Based on NPoco core with ReadyGo style API.</Description>
    <Copyright>Copyright 2016-2026 ToolGood</Copyright>
    <AssemblyTitle>ToolGood.ReadyGo</AssemblyTitle>
    <Authors>ToolGood</Authors>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>ToolGood.ReadyGo</AssemblyName>
    <RootNamespace>ToolGood.ReadyGo</RootNamespace>
    <PackageId>ToolGood.ReadyGo</PackageId>
    <Version>6.0.12</Version>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>ToolGood.ReadyGo.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/toolgood/ToolGood.ReadyGo</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/toolgood/ToolGood.ReadyGo.git</RepositoryUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Product>ToolGood.ReadyGo</Product>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ORM;Micro ORM;NPoco;SQL Server;MySQL;Sqlite;PostgreSQL;Oracle;Firebird</PackageTags>
    <PackageReleaseNotes>支持 .NET Standard 2.0 与 .NET 8/9/10（netstandard2.0 不支持 DateOnly/TimeOnly 映射），链式查询、批量更新/删除、异步查询接口。</PackageReleaseNotes>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <LangVersion>14.0</LangVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>



  <ItemGroup>
    <!-- net10.0 已由 BCL 内置 System.Linq.AsyncEnumerable，无需额外引用 -->
    <PackageReference Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'netstandard2.0'" Include="System.Linq.AsyncEnumerable" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- netstandard2.0 缺少 IAsyncEnumerable / IAsyncDisposable / ValueTask，需要兼容包 -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
    <!-- 数据差异比较（JsonDiffer）依赖 System.Text.Json -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- DynamicMethod / ILGenerator（FastCreate、MemberAccessor 等） -->
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
